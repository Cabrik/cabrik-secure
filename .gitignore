# ---------------------------------------------------------------------------
# Cabrik Secure
# ---------------------------------------------------------------------------

# Lokales Archiv der v1.0-Releases und Testschlüssel.
# Enthält private Schlüssel — darf niemals ins Repository.
_archive_v1/

# Schlüsseldateien und Envelopes: grundsätzlich nie einchecken.
# Testvektoren liegen bewusst unter testvectors/ und sind unten freigegeben.
*.enc
*.key
*.cabrik-key
*.pem
keyfile*.json
*keyfile.json
!testvectors/**/*.json

# Erzeugnisse der CLI beim Ausprobieren.
#
# `*.contact` enthält nur öffentliche Schlüssel und wäre harmlos, `*.contacts`
# und `*.cab` sind es nicht. Die Unterscheidung im Kopf zu behalten ist genau
# die Art Aufgabe, die irgendwann schiefgeht — deshalb bleiben alle drei
# draußen.
*.contact
*.contacts
*.cabrik-contacts
*.cab

# Verzeichnis zum Ausprobieren. Was hier entsteht, ist Wegwerfmaterial.
probe/

# Erzeugnisse des Metadaten-Tests. Die Vorlagen selbst gehoeren ins
# Repository, die bereinigten Ergebnisse entstehen bei jedem Testlauf neu.
*.stripped
# Office-Ergebnisse behalten ihre Endung, damit Word sie oeffnen kann.
*.stripped.*

# ---------------------------------------------------------------------------
# Rust
# ---------------------------------------------------------------------------
target/
**/*.rs.bk
*.pdb

# ---------------------------------------------------------------------------
# Node / Frontend
# ---------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.svelte-kit/
.vite/
*.local

# ---------------------------------------------------------------------------
# Tauri
# ---------------------------------------------------------------------------
src-tauri/target/
gen/

# ---------------------------------------------------------------------------
# Python (legacy/python-v1)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# PyInstaller-Ausgabe
*.manifest
Output/

# ---------------------------------------------------------------------------
# Editoren / OS
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Persoenliche Notizen. Das Muster deckt auch Sicherungskopien ab -- sie
# wandern sonst bei jedem `git add -A` mit ins Repository.
info_Cabrik_Secure*.txt
