{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cabrik Secure",
  "version": "0.1.0",
  "identifier": "de.cabrik.secure",
  "build": {
    "frontendDist": "../../app/oberflaeche/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../../app/oberflaeche run dev",
    "beforeBuildCommand": "npm --prefix ../../app/oberflaeche run build"
  },
  "app": {
    "windows": [
      {
        "title": "Cabrik Secure",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["cabrik"],
        "name": "CabrikEnvelope",
        "description": "Cabrik-Envelope (verschlüsselt)",
        "mimeType": "application/vnd.cabrik.envelope",
        "role": "Editor"
      }
    ]
  },
  "plugins": {}
}
