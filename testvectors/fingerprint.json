{
  "spec_version": "2.0",
  "kind": "fingerprint",
  "description": "Fingerprint und Safety Number nach trust-store.md §2 und §3.",
  "notes": [
    "Erzeugt von einer unabhaengigen Python-Referenz, nicht aus dem",
    "Rust-Code abgeleitet. Eingabeschluessel bestehen aus Wiederholungen",
    "eines einzelnen Bytes; enc_pub_byte, sig_pub_byte und pq_pub_byte",
    "geben dieses Byte an. has_sig bzw. has_pq = false bedeutet, dass",
    "der Schluessel fehlt -- das ist etwas anderes als ein Schluessel aus",
    "lauter Nullen, siehe trust-store.md §2.1."
  ],
  "fingerprints": [
    {
      "id": "fp-full",
      "description": "alle drei Schluessel vorhanden",
      "input": {
        "enc_pub_byte": 1,
        "has_sig": true,
        "sig_pub_byte": 2,
        "has_pq": true,
        "pq_pub_byte": 3
      },
      "expected": {
        "fingerprint_hex": "c865edec442965c69facb4d43c903a23e1ade6147c31a52d08be08d02baa5b32",
        "display_full": "S1JY-VV24-55JW-D7XC-PKA3-S41T-4FGT-VSGM-FGRT-AB88-QR4D-0AXA-BCS0",
        "display": "S1JY-VV24-55JW-D7XC-PKA3-S41T-4FGT-VSGM",
        "short": "S1JYVV24"
      }
    },
    {
      "id": "fp-no-sig",
      "description": "Anonymitaets-Identitaet ohne Signierschluessel",
      "input": {
        "enc_pub_byte": 1,
        "has_sig": false,
        "sig_pub_byte": null,
        "has_pq": true,
        "pq_pub_byte": 3
      },
      "expected": {
        "fingerprint_hex": "506e77718a33e3723b3b24031595f0c30df4d829e0453e4ea8548bab9c5a4095",
        "display_full": "A1Q7-EWCA-6FHQ-4ESV-4G1H-B5FG-RC6Z-9P19-W12K-WKN8-AJ5T-Q72T-82AG",
        "display": "A1Q7-EWCA-6FHQ-4ESV-4G1H-B5FG-RC6Z-9P19",
        "short": "A1Q7EWCA"
      }
    },
    {
      "id": "fp-no-pq",
