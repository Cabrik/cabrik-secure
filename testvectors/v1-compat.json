{
  "spec_version": "2.0",
  "kind": "v1-compat",
  "description": "v1-Keyfiles und -Envelopes zur Pruefung des Migrationslesers.",
  "notes": [
    "Erzeugt mit legacy/python-v1, der eingefrorenen Referenz-",
    "implementierung. Passwort steht im Klartext dabei -- es sind",
    "Wegwerfschluessel.",
    "aad_utf8 ist die kanonische JSON-Serialisierung des Headers",
    "(sortierte Schluessel, keine Leerzeichen, ensure_ascii). v1 nutzt",
    "sie als AEAD-AAD, serialisiert den Envelope selbst aber",
    "UNSORTIERT -- die AAD muss daher neu gebildet werden und kann",
    "nicht aus der Datei uebernommen werden.",
    "v1 nutzt XChaCha20-Poly1305 (24-Byte-Nonce) und Argon2id mit",
    "libsodium-MODERATE: opslimit 3, memlimit 256 MiB, Parallelitaet 1."
  ],
  "keyfiles": [
    {
      "id": "kf-v1-signing",
      "description": "v1-Keyfile mit Signierschluessel",
      "input": {
        "password": "v1-kompat-testpasswort",
        "keyfile_b64": ""
      },
      "expected": {
        "enc_sk_b64": "ovph9jQSBVByyil+GHkN2JrUMYfzvoradhaFq9o3Ibw=",
        "sig_sk_b64": "B28hpbdeOO2o5Al8MwoNyPN4LMxvjHfSK2W9zz8RTfE=",
        "enc_pub_b64": "JdTrYxoWvrQvn2lw36dXydyvnGg/NuT+aYusdiPZlTQ="
      }
    },
    {
      "id": "kf-v1-anonymous",
      "description": "v1-Keyfile ohne Signierschluessel",
      "input": {
        "password": "v1-kompat-testpasswort",
        "keyfile_b64": ""
      },
      "expected": {
        "enc_sk_b64": "PcKqFn5ddihl5tDJMvwJUvJeLLTt0SfE4K1RN+Fh3MY=",
        "sig_sk_b64": null,
        "enc_pub_b64": "k49qVuWooOnF9RNTC7b7Bm/8DPYYV/0kuSfE1ebbJXA="
      }
    }
  ],
  "envelopes": [
    {
      "id": "env-v1-text-signed",
      "description": "Text, mit persistenter Signatur",
      "input": {
        "envelope_b64": "",
        "recipient_keyfile": "kf-v1-signing"
      },
      "expected": {
        "plaintext_b64": "SGFsbG8gYXVzIFZlcnNpb24gMQ==",
        "purpose": "text",
        "signed": true,
        "meta": null,
        "aad_utf8": "{\"alg\":{\"aead\":\"XChaCha20-Poly1305\",\"asym\":\"X25519\",\"kdf\":\"HKDF-SHA256\",\"kdf_keys\":\"argon2id\",\"sig\":\"Ed25519\"},\"branding\":\"Cabrik Secure\",\"eph_pub\":\"xYM0KCKyMULkbN+MGVHQT3ojfmWAs7y2oKqdBOu3iwo=\",\"hkdf_salt\":\"vuTSCoCCkOzzA7xI4BY9lw==\",\"purpose\":\"text\",\"recipient_fp\":\"122517d0\",\"sender_sig_pub\":\"Iao7EHBnhypTYUggcG9tPrDxpmDulfO29TQF3JxgFHk=\",\"ts\":1786049122,\"version\":1}"
      }
    },
    {
      "id": "env-v1-text-anon",
      "description": "Text, anonym (ephemerer Signierschluessel)",
      "input": {
        "envelope_b64": "",
        "recipient_keyfile": "kf-v1-signing"
      },
      "expected": {
        "plaintext_b64": "YW5vbnltZSBOYWNocmljaHQ=",
        "purpose": "text",
        "signed": true,
        "meta": null,
        "aad_utf8": "{\"alg\":{\"aead\":\"XChaCha20-Poly1305\",\"asym\":\"X25519\",\"kdf\":\"HKDF-SHA256\",\"kdf_keys\":\"argon2id\",\"sig\":\"Ed25519\"},\"branding\":\"Cabrik Secure\",\"eph_pub\":\"JiHSck3JVq3+FMkze09TTXNADVjeNqrEG1DI56/BwlM=\",\"hkdf_salt\":\"5ShOQGUvG3Ye8AcqipfBfQ==\",\"purpose\":\"text\",\"recipient_fp\":\"122517d0\",\"sender_sig_pub\":\"fClcFcKKKbcbMBQrmUQPqr//+XPshQ2MsiU5IKVBewo=\",\"ts\":1786049122,\"version\":1}"
      }
    },
    {
      "id": "env-v1-file",
      "description": "Datei mit Namen und Groesse im Klartext-Header",
      "input": {
        "envelope_b64": "",
        "recipient_keyfile": "kf-v1-signing"
      },
      "expected": {
        "plaintext_b64": "",
        "purpose": "file",
        "signed": true,
        "meta": {
          "filename": "Kuendigung_vertraulich.pdf",
          "size": "440"
        },
        "aad_utf8": "{\"alg\":{\"aead\":\"XChaCha20-Poly1305\",\"asym\":\"X25519\",\"kdf\":\"HKDF-SHA256\",\"kdf_keys\":\"argon2id\",\"sig\":\"Ed25519\"},\"branding\":\"Cabrik Secure\",\"eph_pub\":\"WjJ1sOcpzA4ZS1Oam+0wA60D8uoJoakulNdjDTJ08Ek=\",\"hkdf_salt\":\"blZ1ZLcQXBeMjvHSajBB/Q==\",\"meta\":{\"filename\":\"Kuendigung_vertraulich.pdf\",\"size\":\"440\"},\"purpose\":\"file\",\"recipient_fp\":\"122517d0\",\"sender_sig_pub\":\"Iao7EHBnhypTYUggcG9tPrDxpmDulfO29TQF3JxgFHk=\",\"ts\":1786049122,\"version\":1}"
      }
    },
    {
      "id": "env-v1-umlaut",
      "description": "Dateiname mit Umlauten -- prueft ensure_ascii",
      "input": {
        "envelope_b64": "",
        "recipient_keyfile": "kf-v1-signing"
      },
      "expected": {
        "plaintext_b64": "eA==",
        "purpose": "file",
        "signed": true,
        "meta": {
          "filename": "Bericht_Grün_Übersicht.pdf",
          "size": "1"
        },
        "aad_utf8": "{\"alg\":{\"aead\":\"XChaCha20-Poly1305\",\"asym\":\"X25519\",\"kdf\":\"HKDF-SHA256\",\"kdf_keys\":\"argon2id\",\"sig\":\"Ed25519\"},\"branding\":\"Cabrik Secure\",\"eph_pub\":\"SdRRcbLZ6hHtIC2vVcN5lUrG1e/c6LSBEvHYUGWW9z8=\",\"hkdf_salt\":\"fbDswj4zExZx/fwgh9osQg==\",\"meta\":{\"filename\":\"Bericht_Gr\\u00fcn_\\u00dcbersicht.pdf\",\"size\":\"1\"},\"purpose\":\"file\",\"recipient_fp\":\"122517d0\",\"sender_sig_pub\":\"Iao7EHBnhypTYUggcG9tPrDxpmDulfO29TQF3JxgFHk=\",\"ts\":1786049122,\"version\":1}"
      }
    },
    {
      "id": "env-v1-empty",
      "description": "leerer Klartext",
      "input": {
        "envelope_b64": "",
        "recipient_keyfile": "kf-v1-signing"
      },
      "expected": {
        "plaintext_b64": "",
        "purpose": "text",
        "signed": true,
        "meta": null,
        "aad_utf8": "{\"alg\":{\"aead\":\"XChaCha20-Poly1305\",\"asym\":\"X25519\",\"kdf\":\"HKDF-SHA256\",\"kdf_keys\":\"argon2id\",\"sig\":\"Ed25519\"},\"branding\":\"Cabrik Secure\",\"eph_pub\":\"UeCcIQL5zxTU46JwfsNwZffgUTnRyurvPCHfc/GmYlI=\",\"hkdf_salt\":\"9riHA5u8pGTtv8NbpkQpYg==\",\"purpose\":\"text\",\"recipient_fp\":\"122517d0\",\"sender_sig_pub\":\"wnQJcZ1tWJhl+QW925bbUq96QBcXBhNxqg0XtlV+/eM=\",\"ts\":1786049122,\"version\":1}"
      }
    }
  ]
}
